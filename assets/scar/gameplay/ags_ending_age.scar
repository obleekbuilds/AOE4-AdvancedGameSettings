--
-- Description:
-- Restricts players to advance past final age.
---------------------------------------------------------------------------------------------------

AGS_ENDING_AGE_MODULE = "AGS_EndingAge"
AGS_ENDING_AGE_ABB_EW_DARK = BP_GetUpgradeBlueprint("upgrade_add_culture_wing")
AGS_ENDING_AGE_ABB_MW_DARK = BP_GetUpgradeBlueprint("upgrade_add_economy_wing")
AGS_ENDING_AGE_ABB_CW_DARK = BP_GetUpgradeBlueprint("upgrade_add_military_wing")
AGS_ENDING_AGE_ABB_TW_DARK = BP_GetUpgradeBlueprint("upgrade_add_trade_wing")
AGS_ENDING_AGE_ABB_EW_FEUDAL = BP_GetUpgradeBlueprint("upgrade_add_culture_wing_feudal")
AGS_ENDING_AGE_ABB_MW_FEUDAL = BP_GetUpgradeBlueprint("upgrade_add_economy_wing_feudal")
AGS_ENDING_AGE_ABB_CW_FEUDAL = BP_GetUpgradeBlueprint("upgrade_add_military_wing_feudal")
AGS_ENDING_AGE_ABB_TW_FEUDAL = BP_GetUpgradeBlueprint("upgrade_add_trade_wing_feudal")
AGS_ENDING_AGE_ABB_EW_CASTLE = BP_GetUpgradeBlueprint("upgrade_add_culture_wing_castle")
AGS_ENDING_AGE_ABB_MW_CASTLE = BP_GetUpgradeBlueprint("upgrade_add_economy_wing_castle")
AGS_ENDING_AGE_ABB_CW_CASTLE = BP_GetUpgradeBlueprint("upgrade_add_military_wing_castle")
AGS_ENDING_AGE_ABB_TW_CASTLE = BP_GetUpgradeBlueprint("upgrade_add_trade_wing_castle")
AGS_ENDING_AGE_ABB_EW_IMPERIAL = BP_GetUpgradeBlueprint("upgrade_add_culture_wing_imperial")
AGS_ENDING_AGE_ABB_MW_IMPERIAL = BP_GetUpgradeBlueprint("upgrade_add_economy_wing_imperial")
AGS_ENDING_AGE_ABB_CW_IMPERIAL = BP_GetUpgradeBlueprint("upgrade_add_military_wing_imperial")
AGS_ENDING_AGE_ABB_TW_IMPERIAL = BP_GetUpgradeBlueprint("upgrade_add_trade_wing_imperial")

-- FORK FIX: wing upgrades grouped per tier so base Abbasid and the Ayyubid variant
-- (abbasid_ha_01, which ages up via its own wing blueprint family) share the removal logic.
AGS_ENDING_AGE_ABB_WINGS = {
	dark = { AGS_ENDING_AGE_ABB_EW_DARK, AGS_ENDING_AGE_ABB_MW_DARK, AGS_ENDING_AGE_ABB_CW_DARK, AGS_ENDING_AGE_ABB_TW_DARK },
	feudal = { AGS_ENDING_AGE_ABB_EW_FEUDAL, AGS_ENDING_AGE_ABB_MW_FEUDAL, AGS_ENDING_AGE_ABB_CW_FEUDAL, AGS_ENDING_AGE_ABB_TW_FEUDAL },
	castle = { AGS_ENDING_AGE_ABB_EW_CASTLE, AGS_ENDING_AGE_ABB_MW_CASTLE, AGS_ENDING_AGE_ABB_CW_CASTLE, AGS_ENDING_AGE_ABB_TW_CASTLE },
	imperial = { AGS_ENDING_AGE_ABB_EW_IMPERIAL, AGS_ENDING_AGE_ABB_MW_IMPERIAL, AGS_ENDING_AGE_ABB_CW_IMPERIAL, AGS_ENDING_AGE_ABB_TW_IMPERIAL },
}
-- FORK FIX: abbasid_ha_01 wing family (upgrade_add_*_wing_<age>_{a,b}_abb_ha_01), resolved
-- lazily by AGS_EndingAge_GetAyyubidWings so a data rename degrades instead of fatal-erroring.
AGS_ENDING_AGE_ABB_HA_01_WINGS = nil
-- FORK FIX: <prefix>age3/age4 and <prefix>ageN_wonders construction-menu tokens exist in game
-- data only for these prefixes; other civs (jin, lancaster, templar, *_ha_* variants,
-- ayyubid_cmp) have none, so they must degrade to the player_max_age cap.
AGS_ENDING_AGE_MENU_PREFIXES = {
	["byz_"] = true, ["chi_"] = true, ["cru_"] = true, ["eng_"] = true, ["fre_"] = true,
	["hre_"] = true, ["jpn_"] = true, ["mal_"] = true, ["mon_"] = true, ["rus_"] = true,
	["sul_"] = true,
}

---------------------------------------------------------------------------------------------------
-- Delegates:
---------------------------------------------------------------------------------------------------

Core_RegisterModule(AGS_ENDING_AGE_MODULE)	

function AGS_EndingAge_UpdateModuleSettings()
	AGS_Print("AGS_EndingAge_UpdateModuleSettings")
	if AGS_GLOBAL_SETTINGS.EndingAge == AGS_GS_AGE_LATE_IMPERIAL then
		Core_UnregisterModule(AGS_ENDING_AGE_MODULE)
	end
end

function AGS_EndingAge_PresetFinalize()
	AGS_Print("AGS_EndingAge_PresetFinalize")
	AGS_EndingAge_LockAgeUps()
end

---------------------------------------------------------------------------------------------------
-- Functions:
---------------------------------------------------------------------------------------------------

function AGS_EndingAge_LockAgeUps()
	for _, player in pairs(PLAYERS) do
		AGS_EndingAge_SetMaximumAge(player, AGS_GLOBAL_SETTINGS.EndingAge)
	end
end

function AGS_EndingAge_SetMaximumAge(player, max_age)
	local prefix = AGS_CIV_PREFIXES[player.raceName]
	-- FORK FIX: a civ missing from AGS_CIV_PREFIXES (newer DLC civ) has no known
	-- menu names to restrict; keep the engine-side age cap and skip the rest
	-- instead of crashing on a nil string concat.
	if prefix == nil then
		AGS_Print("AGS WARNING: no civ prefix for '" .. tostring(player.raceName) .. "', skipping menu restrictions")
		Player_SetStateModelInt(player.id, "player_max_age", AGS_GLOBAL_SETTINGS.EndingAge)
		return
	end

	if prefix == "ott_" then
		prefix = "sul_"
		-- This is here due to ottomans not having their own, but they are using other civ
		-- for now it looks like it's delhi menu that is used.
		AGS_Print(prefix)
	end
	
	-- FORK FIX: abbasid_ha_01 (Ayyubids) also ages up via wing upgrades, not landmark menus.
	if player.raceName == AGS_CIV_ABBASID or player.raceName == AGS_CIV_ABBASID_HA_01 then
		AGS_EndingAge_RemoveAgeTechnology(player, prefix, max_age)
	-- FORK FIX: civs without real ageN/ageN_wonders menu tokens would target nonexistent
	-- names (silent no-op at best); keep the engine-side age cap below and skip the calls.
	elseif AGS_ENDING_AGE_MENU_PREFIXES[prefix] == nil then
		AGS_Print("AGS WARNING: no construction menus for prefix '" .. prefix .. "', relying on player_max_age only")
	else
		if max_age < AGS_GS_AGE_FEUDAL then
			-- This is commented due to TC availability for nomad...
			--Player_SetConstructionMenuAvailability(player.id, prefix.."age2", ITEM_REMOVED)
			Player_SetConstructionMenuAvailability(player.id, prefix.."age1_wonders", ITEM_REMOVED)
		end
		if max_age < AGS_GS_AGE_CASTLE then 
			Player_SetConstructionMenuAvailability(player.id, prefix.."age3", ITEM_REMOVED)
			Player_SetConstructionMenuAvailability(player.id, prefix.."age2_wonders", ITEM_REMOVED)
		end
		if max_age < AGS_GS_AGE_IMPERIAL then 
			Player_SetConstructionMenuAvailability(player.id, prefix.."age4", ITEM_REMOVED)
			Player_SetConstructionMenuAvailability(player.id, prefix.."age3_wonders", ITEM_REMOVED)
		end
	end
	
	Player_SetStateModelInt(player.id, "player_max_age", AGS_GLOBAL_SETTINGS.EndingAge)
end

function AGS_EndingAge_RemoveAgeTechnology(player, prefix, final_age)
	-- FORK FIX: pick the wing family per civ; abbasid_ha_01 has its own wing blueprints
	-- and no abb_ha_01_* construction menus, so menu removals stay base-Abbasid only.
	local is_base_abbasid = player.raceName == AGS_CIV_ABBASID
	local wings = AGS_ENDING_AGE_ABB_WINGS
	if not is_base_abbasid then
		wings = AGS_EndingAge_GetAyyubidWings()
	end
	if final_age <= AGS_GS_AGE_DARK then
		Player_SetEntityProductionAvailability(player.id, AGS_GetCivilizationEntity(player.raceName, AGS_BP_HOW), ITEM_REMOVED)
		AGS_EndingAge_RemoveWingTier(player, wings, "dark")
	end
	if final_age <= AGS_GS_AGE_FEUDAL then
		if is_base_abbasid then
			Player_SetConstructionMenuAvailability(player.id, prefix.."age3", ITEM_REMOVED)
		end
		AGS_EndingAge_RemoveWingTier(player, wings, "feudal")
	end
	if final_age <= AGS_GS_AGE_CASTLE then
		if is_base_abbasid then
			Player_SetConstructionMenuAvailability(player.id, prefix.."age4", ITEM_REMOVED)
		end
		AGS_EndingAge_RemoveWingTier(player, wings, "castle")
		-- FORK FIX: imperial-tier wings are researched IN Imperial (Relic removes them only
		-- when the cap is below Imperial); removing them at cap == Imperial was an off-by-one
		-- that stripped Abbasid content no other civ lost.
		AGS_EndingAge_RemoveWingTier(player, wings, "imperial")
	end
end

function AGS_EndingAge_RemoveWingTier(player, wings, age)
	if wings == nil then
		return
	end
	for _, wing_upgrade in pairs(wings[age]) do
		Player_SetUpgradeAvailability(player.id, wing_upgrade, ITEM_REMOVED)
	end
end

-- FORK FIX: resolve the abbasid_ha_01 wing upgrades on first use, pcall-guarded so a
-- missing blueprint degrades to a warning (no wing removal) instead of a fatal error.
function AGS_EndingAge_GetAyyubidWings()
	if AGS_ENDING_AGE_ABB_HA_01_WINGS ~= nil then
		return AGS_ENDING_AGE_ABB_HA_01_WINGS
	end
	local wings = { dark = {}, feudal = {}, castle = {}, imperial = {} }
	for age, tier in pairs(wings) do
		for _, wing in pairs({"culture", "economy", "military", "trade"}) do
			for _, variant in pairs({"a", "b"}) do
				local wing_name = "upgrade_add_" .. wing .. "_wing_" .. age .. "_" .. variant .. "_abb_ha_01"
				local success, wing_upgrade = pcall(BP_GetUpgradeBlueprint, wing_name)
				if not success or wing_upgrade == nil then
					AGS_Print("AGS WARNING: missing wing upgrade '" .. wing_name .. "', skipping wing removal")
					return nil
				end
				table.insert(tier, wing_upgrade)
			end
		end
	end
	AGS_ENDING_AGE_ABB_HA_01_WINGS = wings
	return wings
end